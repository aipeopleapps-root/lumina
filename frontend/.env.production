# Committed production build config for the live Static Web App (lumina-swa). Vite gives
# .env.[mode] higher precedence than .env.local for shared keys — see
# https://vite.dev/guide/env-and-mode.html#env-files — so this always wins for `npm run build`
# (production mode) regardless of whatever a developer's local .env.local currently contains.
#
# Added after an incident where .env.local's VITE_LOCAL_DEV_TOKEN (a local-only MSAL bypass
# shim, plus a VITE_API_ENDPOINT pointed at localhost:8787) got baked into a production build and
# deployed live — silently authenticating every visitor as a hardcoded test account with no real
# login. .env.local must never be the source of truth for what ships; this file is.
VITE_API_ENDPOINT=https://lumina-apim.azure-api.net
VITE_AZURE_TENANT_ID=9eb4680c-8bfd-4a8e-ab9a-2ac841f47d25
VITE_AZURE_CLIENT_ID=5cc4858b-aa23-4916-a34f-dd3a028d197d
VITE_AZURE_API_SCOPE=api://5cc4858b-aa23-4916-a34f-dd3a028d197d/access_as_user

# Explicitly cleared, not omitted — Vite merges .env files per-key, so a key this file doesn't
# define at all falls through to .env.local's value even in production mode (confirmed live:
# omitting this line still shipped .env.local's dev-bypass token to production). An empty value
# here is falsy in the msal.ts check and reliably wins over whatever a developer's local
# .env.local happens to contain.
VITE_LOCAL_DEV_TOKEN=
