# Copy to .env.local and fill in the Bicep deploy outputs (see bicep/README.md).
# VITE_API_ENDPOINT is the APIM gateway URL (main.bicep output `apiGatewayUrl`).
VITE_API_ENDPOINT=https://lumina-apim.azure-api.net
# VITE_AZURE_TENANT_ID / VITE_AZURE_CLIENT_ID are the same values Phase 3a's
# register-entra-app.sh prints (entraTenantId/entraAppClientId, also passed to
# the Bicep deploy) — see docs/AZURE_MIGRATION.md's Phase 3a Log for the current values.
VITE_AZURE_TENANT_ID=00000000-0000-0000-0000-000000000000
VITE_AZURE_CLIENT_ID=00000000-0000-0000-0000-000000000000
# The API scope register-entra-app.sh exposes — api://<VITE_AZURE_CLIENT_ID>/access_as_user
VITE_AZURE_API_SCOPE=api://00000000-0000-0000-0000-000000000000/access_as_user
