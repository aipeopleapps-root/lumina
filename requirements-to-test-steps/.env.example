# LLM Gateway
LLM_GATEWAY_URL=https://genai-dev.example.com/openai/v1/chat/completions
LLM_GATEWAY_API_KEY=your-bearer-token-here
LLM_MODEL=gpt-4o
LLM_MAX_TOKENS=4096
LLM_TIMEOUT_SECONDS=60

# Azure Blob Storage
AZURE_STORAGE_ACCOUNT_URL=https://yourstorageaccount.blob.core.windows.net
AZURE_STORAGE_INPUT_CONTAINER=input-files
AZURE_STORAGE_OUTPUT_CONTAINER=output-files

# Auth: set to true to use Managed Identity (Azure), false to use connection string (local dev)
USE_MANAGED_IDENTITY=false
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=youraccount;AccountKey=yourkey;EndpointSuffix=core.windows.net

# App
APP_ENV=local

# ── Azure Cosmos DB ────────────────────────────────────────────────────────────
# Set USE_COSMOS=false to disable persistence (app still works, runs are not saved)
USE_COSMOS=false
COSMOS_ENDPOINT=https://<account-name>.documents.azure.com:443/
COSMOS_KEY=<primary-or-secondary-key>       # leave blank when COSMOS_USE_MANAGED_IDENTITY=true
COSMOS_DATABASE_NAME=req-to-test
COSMOS_CONTAINER_NAME=pipeline-runs
# Set to true on Deloitte infra — Container App uses Managed Identity, no key required
COSMOS_USE_MANAGED_IDENTITY=false

# Project identity — one unique value per Container App deployment / client engagement
# Examples: nine-hris-2025, clientB-payroll-2026, internal-demo
PROJECT_ID=default-project

# ── Microsoft Entra External ID ───────────────────────────────────────────────
# Leave AZURE_AD_CLIENT_ID empty to disable auth (local dev without sign-in)
AZURE_AD_TENANT_NAME=<your-b2c-tenant-name>
AZURE_AD_TENANT_ID=<your-tenant-id-guid>
AZURE_AD_CLIENT_ID=<your-app-registration-client-id>
AZURE_AD_USER_FLOW=signupsignin
