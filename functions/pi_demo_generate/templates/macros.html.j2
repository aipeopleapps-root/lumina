{# Macro library — one macro per structured card/section `type` in the democontent
   schema (see prompt_demo_content.md). These are the ONLY place HTML is produced
   for LLM-sourced content — the LLM never emits markup, only the typed JSON these
   macros render. Autoescaping is on for the whole environment, so every {{ }} below
   is safe against a value that happens to contain HTML-special characters. #}

{% macro match_card(card) %}
<div class="card">
  <div class="card-head"><span class="t">{{ card.title }}</span></div>
  <div class="kv">
    {% for row in card.rows or [] %}
    <div class="k">{{ row.label }}</div><div class="v">{{ row.value }}</div>
    {% endfor %}
  </div>
  {% if card.actions %}
  <div class="card-actions">
    {% for action in card.actions %}
    <button class="btn {{ 'primary' if loop.first else 'ghost' }}">{{ action }}</button>
    {% endfor %}
  </div>
  {% endif %}
</div>
{% endmacro %}

{% macro approval_list(card) %}
<div class="card">
  <div class="card-head"><span class="t">{{ card.title }}</span></div>
  <div class="approval-list">
    {% for item in card['items'] or [] %}
    <div class="approval-item">
      <div class="who"><div class="dot-init">{{ (item.name or '?')[:2].upper() }}</div>{{ item.name }}{% if item.role %} ({{ item.role }}){% endif %}</div>
      <span class="chip {{ 'ok' if item.status == 'approved' else ('flagged' if item.status == 'flagged' else 'pending') }}">{{ (item.status or 'pending').capitalize() }}</span>
    </div>
    {% endfor %}
  </div>
</div>
{% endmacro %}

{% macro checklist(card) %}
<div class="card">
  <div class="card-head"><span class="t">{{ card.title }}</span></div>
  <div class="checklist">
    {% for item in card['items'] or [] %}
    <div class="item {{ '' if item.done else 'pending' }}"><div class="tick">{{ '✓' if item.done else '' }}</div>{{ item.label }}</div>
    {% endfor %}
  </div>
</div>
{% endmacro %}

{% macro stat_row(card) %}
<div class="card">
  <div class="stat-row">
    {% for stat in card.stats or [] %}
    <div class="stat"><div class="num">{{ stat.value }}</div><div class="lbl">{{ stat.label }}</div></div>
    {% endfor %}
  </div>
</div>
{% endmacro %}

{% macro roi_card(card) %}
<div class="card roi-card">
  <div class="card-head"><span class="t">{{ card.title }}</span></div>
  <div class="stat-row">
    {% for stat in card.stats or [] %}
    <div class="stat"><div class="num">{{ stat.value }}</div><div class="lbl">{{ stat.label }}</div></div>
    {% endfor %}
  </div>
  {% if card.note %}<div class="footnote" style="margin-top:8px;">{{ card.note }}</div>{% endif %}
</div>
{% endmacro %}

{# ── Workspace dashboard sections ──────────────────────────────────────── #}

{% macro stat_cards(cards) %}
<div class="stat-cards">
  {% for c in cards or [] %}
  <div class="stat-card{{ ' accent' if loop.first else '' }}"><div class="num">{{ c.value }}</div><div class="lbl">{{ c.label }}</div></div>
  {% endfor %}
</div>
{% endmacro %}

{% macro org_chart(chart) %}
<div>
  <div class="ws-section-label">Structure — before &amp; after</div>
  <div class="orgchart-wrap">
    <div class="orgchart-col">
      <div class="colhead">Before</div>
      {% for node in chart.before or [] %}
      <div class="org-node{{ ' top' if loop.first else '' }}"><div class="role">{{ node.role }}</div>{% if node.name %}<div class="count">{{ node.name }}</div>{% endif %}</div>
      {% if loop.first %}<div class="org-connector"></div>{% endif %}
      {% endfor %}
    </div>
    <div class="orgchart-col">
      <div class="colhead">After</div>
      {% for node in chart.after or [] %}
      <div class="org-node{{ ' top' if loop.first else '' }}"><div class="role">{{ node.role }}</div>{% if node.name %}<div class="count">{{ node.name }}</div>{% endif %}</div>
      {% if loop.first %}<div class="org-connector"></div>{% endif %}
      {% endfor %}
    </div>
  </div>
</div>
{% endmacro %}

{% macro doc_section(section) %}
<div class="doc-section">
  <div class="dh">
    <span class="name">{{ section.heading }}</span>
    {% if section.source_badge %}<span class="src">{{ section.source_badge.label }}</span>{% endif %}
  </div>
  <p>{{ section.body }}</p>
</div>
{% endmacro %}

{% macro bar_chart(chart) %}
<div>
  <div class="ws-section-label">{{ chart.title }}</div>
  <div class="barchart" style="margin-top:10px;">
    {% for bar in chart.bars or [] %}
    {% set max_v = bar.max or 100 %}
    {% set pct = ((bar.value / max_v) * 100) if max_v else 0 %}
    <div class="bar-row">
      <div class="label">{{ bar.label }}</div>
      <div class="bar-track"><div class="bar-fill {{ 'good' if pct >= 75 else ('warn' if pct < 65 else '') }}" style="width:{{ pct }}%"></div></div>
      <div class="val">{{ bar.value }}</div>
    </div>
    {% endfor %}
  </div>
</div>
{% endmacro %}

{% macro risk_list(items) %}
<div>
  <div class="ws-section-label">Flagged risks &amp; recommendations</div>
  <div class="risk-list" style="margin-top:10px;">
    {% for item in items or [] %}
    <div class="risk-item">
      <div class="ri-main"><div class="ri-team">{{ item.title }}</div><div class="ri-desc">{{ item.description }}</div></div>
      <span class="chip {{ 'ok' if item.severity == 'low' else ('flagged' if item.severity == 'high' else 'pending') }}">{{ item.severity.capitalize() }}</span>
    </div>
    {% endfor %}
  </div>
</div>
{% endmacro %}

{# ── Shell-level macros ────────────────────────────────────────────────── #}

{% macro agent_icon(kind) %}
{% if kind == 'workspace' %}
<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="4" width="18" height="6" rx="1.5"/><rect x="3" y="14" width="8" height="6" rx="1.5"/><rect x="13" y="14" width="8" height="6" rx="1.5"/></svg>
{% else %}
<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M3 5h18v11a1 1 0 0 1-1 1H8l-4 4V5z"/></svg>
{% endif %}
{% endmacro %}

{% macro nav_item(agent) %}
<div class="nav-item" data-agent="{{ agent.agent_id }}">
  {{ agent_icon(agent.kind) }}
  {{ agent.name }}
</div>
{% endmacro %}

{% macro suite_item(agent) %}
<div class="suite-item" data-agent="{{ agent.agent_id }}">
  {{ agent_icon(agent.kind) }}
  {{ agent.name }}
  <span class="tag">{{ 'Conversational' if agent.kind == 'conversational' else 'Workspace' }}</span>
</div>
{% endmacro %}

{% macro home_card(agent) %}
<div class="agent-card" data-agent="{{ agent.agent_id }}">
  <div class="ac-orb">{{ agent_icon(agent.kind) }}</div>
  <div class="ac-name">{{ agent.name }}</div>
  <div class="ac-desc">{{ agent.description or '' }}</div>
  <span class="ac-tag {{ 'conv' if agent.kind == 'conversational' else 'ws' }}">{{ 'Conversational' if agent.kind == 'conversational' else 'Workspace' }}</span>
</div>
{% endmacro %}

{% macro disclaimer_footer(theme) %}
<div class="footnote">Demo built to align visually with Workday's Canvas Design System. Not an official Workday or {{ theme.clientName }} product — for internal discovery purposes only.</div>
{% endmacro %}
