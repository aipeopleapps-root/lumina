// Consumption-tier APIM will not expose an API on the public gateway at all unless it's
// linked to at least one Product — confirmed live (Phase 7 session 14): with the API alone
// (even with subscriptionRequired: false, no product), every call through the gateway 404'd
// while the same call worked calling the Function App directly. `subscriptionRequired: false`
// here (on both the product and the api above) means callers don't need an
// Ocp-Apim-Subscription-Key — auth is still fully enforced by the validate-jwt policy below.
resource product 'Microsoft.ApiManagement/service/products@2024-05-01' = {
  parent: apim
  name: 'lumina-product'
  properties: {
    displayName: 'Lumina'
    subscriptionRequired: false
    state: 'published'
  }
}

resource productApi 'Microsoft.ApiManagement/service/products/apis@2024-05-01' = {
  parent: product
  name: api.name
}

// Built as a joined array of regular (interpolating) strings rather than a triple-quoted
// block — Bicep's ''' multi-line strings are RAW/non-interpolating (${...} is treated as
// literal text inside them), which would have silently deployed the placeholder text below
// instead of the real tenant ID/claim names/CORS origins. Regular strings interpolate
// correctly and don't collide with APIM's own {{named-value}} braces or the C# policy
// expressions' `new[] { "" }` braces the way Bicep's format()-with-{0}-placeholders would.
var corsOriginLines = [for origin in corsAllowedOrigins: '        <origin>${origin}</origin>']

var policyLines = concat(
  [
    '<policies>'
    '  <inbound>'
    '    <base />'
    '    <cors allow-credentials="false">'
    '      <allowed-origins>'
  ],
  corsOriginLines,
  [
    '      </allowed-origins>'
    '      <allowed-methods>'
    '        <method>GET</method>'
    '        <method>POST</method>'
    '        <method>PATCH</method>'
    '        <method>DELETE</method>'
    '        <method>OPTIONS</method>'
    '      </allowed-methods>'
    '      <allowed-headers>'
    '        <header>Content-Type</header>'
    '        <header>Authorization</header>'
    '        <header>X-Client-Tenant</header>'
    '      </allowed-headers>'
    '      <expose-headers>'
    '        <header>*</header>'
    '      </expose-headers>'
    '    </cors>'
    '    <choose>'
    '      <when condition="@(context.Request.OriginalUrl.Path.EndsWith(&quot;/mfa/request-reset&quot;))">'
    '        <!-- Public route, no JWT: mirrors stack.ts:509-514, user is stuck at the MFA challenge so has no full token yet. -->'
    '      </when>'
    '      <otherwise>'
    '        <validate-jwt header-name="Authorization" failed-validation-httpcode="401" require-scheme="Bearer" output-token-variable-name="jwt">'
    // Entra/AAD's login endpoint has no environment()-exposed equivalent to swap in (unlike
    // storage's environment().suffixes.storage used in compute.bicep) — this project has no
    // multi-cloud requirement, matching the same tradeoff data.bicep already made for its
    // privatelink.*.core.windows.net zone names.
    #disable-next-line no-hardcoded-env-urls
    '          <openid-config url="https://login.microsoftonline.com/${entraTenantId}/v2.0/.well-known/openid-configuration" />'
    '          <audiences>'
    '            <audience>${entraAppClientId}</audience>'
    '          </audiences>'
    '        </validate-jwt>'
    '        <set-header name="x-tenant-id" exists-action="override">'
    '          <value>@(((Jwt)context.Variables["jwt"]).Claims.GetValueOrDefault("${tenantIdClaim}", new[] { "" })[0])</value>'
    '        </set-header>'
    '        <set-header name="x-user-role" exists-action="override">'
    '          <value>@(((Jwt)context.Variables["jwt"]).Claims.GetValueOrDefault("${roleClaim}", new[] { "" })[0])</value>'
    '        </set-header>'
    '        <set-header name="x-user-sub" exists-action="override">'
    '          <value>@(((Jwt)context.Variables["jwt"]).Claims.GetValueOrDefault("oid", new[] { "" })[0])</value>'
    '        </set-header>'
    '        <set-header name="x-user-email" exists-action="override">'
    '          <value>@(((Jwt)context.Variables["jwt"]).Claims.GetValueOrDefault("email", new[] { "" })[0])</value>'
    '        </set-header>'
    '      </otherwise>'
    '    </choose>'
    '    <set-header name="x-functions-key" exists-action="override">'
    '      <value>{{function-host-key}}</value>'
    '    </set-header>'
    '  </inbound>'
    '  <backend>'
    '    <base />'
    '  </backend>'
    '  <outbound>'
    '    <base />'
    '  </outbound>'
    '  <on-error>'
    '    <base />'
    '  </on-error>'
    '</policies>'
  ]
)

resource apiPolicy 'Microsoft.ApiManagement/service/apis/policies@2024-05-01' = {
  parent: api
  name: 'policy'
  properties: {
    format: 'xml'
    value: join(policyLines, '\n')
  }
  dependsOn: [
    functionKeyNamedValue
  ]
}

