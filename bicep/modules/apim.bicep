// Phase 7 — API Management
// Fronts the single Function App with JWT validation against Entra, translating the validated
// token's claims into the x-tenant-id/x-user-role/x-user-sub/x-user-email headers
// functions/common/tenant.py already expects (see Phase 5's "APIM header contract" design).
//
// SKU: Consumption (not Developer/Premium) — serverless, pay-per-call, no VNet integration
// needed, deploys in minutes instead of ~45. Matches this migration's Phase 0 locked-in
// decision ("no evidence of production load — [complexity] isn't worth it") and the 2-demo-tenant
// scale of everything else in this stack. Because Consumption-tier APIM has no stable/documented
// outbound IP the Function App could allowlist, the Function App is instead locked down with
// per-request Function-key auth (auth_level=FUNCTION in function_app.py) rather than IP
// restriction — APIM injects the key via the named value below on every request.
//
// Routing model: 48 individually-declared APIM operations (one per (route, method) pair
// from functions/function_app.py's route table, generated by a one-off script — same
// route/method data, same reason it's generated rather than hand-transcribed as
// function_app.py's static route functions were). This was NOT the original design: the
// original was a single wildcard pass-through operation (urlTemplate '/*', later '/{*path}'),
// on the theory that method/path routing already happens inside the Function App itself so
// APIM's job here is only auth + CORS, not duplicating that dispatch logic. Confirmed live
// (Phase 7 session 14) that the wildcard operation never actually matched any real request —
// every call 404'd at the gateway — while a hand-declared static operation for the exact same
// path worked immediately and end-to-end. Root cause not fully confirmed (tried both `/*` and
// the documented `/{*path}` catch-all syntax, neither worked; API-level config, Product
// association, and the policy itself were all independently verified correct via a static
// operation before concluding this), but empirically: explicit operations work, wildcard
// operations do not, on this APIM instance/tier. The auth+CORS+header-injection policy below
// is still applied once at the API level (not per-operation), so this isn't 48x the policy
// logic — just 48x the routing declaration.
//
// ⚠️ Known-open caveat carried over from Phase 3a (see docs/AZURE_MIGRATION.md Log,
// 2026-08-07): the extension_<appId>_tenant_id/_role claims this policy reads have not been
// confirmed to actually appear on a live ID token yet (only reproduced against a consumer/MSA
// -federated test account) — re-verify claim presence against a real work/school account (e.g.
// after the Deloitte tenant re-registration) before trusting this in production.

@description('Azure region')
param location string

@description('Naming prefix for all resources (e.g. "lumina")')
param namePrefix string

@description('Publisher email — required by Microsoft.ApiManagement/service, not otherwise used at this scale')
param publisherEmail string

@description('Publisher/organization name shown in the APIM developer portal')
param publisherName string = 'Lumina'

@description('Function App name (from compute.bicep output) — used to look up its host key via listKeys() and build the backend URL')
param functionAppName string

@description('BP Workbook Generation Function App name (from bpworkbook.bicep output) — a second, separate backend (different runtime/deployable unit, see that module\'s own comment), routed via its own API/operations/policy below rather than mixed into the main one')
param bpworkbookFunctionAppName string

@description('Entra tenant ID (Workforce tenant hosting the app registration) — see Phase 3a in docs/AZURE_MIGRATION.md. Re-point this when re-registering against the Deloitte tenant.')
param entraTenantId string

@description('Entra app registration client ID — JWT audience, and the source of the extension_<appId>_tenant_id/_role claim names (dashes stripped, matching graph.py/register-entra-app.sh)')
param entraAppClientId string

@description('CORS allowed origins — mirrors stack.ts:319-325\'s httpApi corsPreflight config')
param corsAllowedOrigins array = [
  'http://localhost:5173'
  'http://localhost:3000'
]

// Directory-extension optional claims show up on the token under a short `extn.<name>`
// form — NOT `extension_<appId-no-dashes>_<name>`, the name Graph uses for the underlying
// user attribute (see functions/common/graph.py / register-entra-app.sh, a different
// context). Confirmed by decoding a real token issued against the live dev tenant, not
// from documentation — the two naming schemes look similar enough to guess wrong, which is
// exactly what happened here originally. See docs/AZURE_MIGRATION.md Log. Unlike the
// Graph-side name, this one does NOT depend on entraAppClientId at all.
var tenantIdClaim = 'extn.tenant_id'
var roleClaim = 'extn.role'

// Function host key, looked up directly rather than threaded through compute.bicep as a
// secure output — avoids that module needing to know APIM cares about it at all.
var functionHostKeys = listKeys(resourceId('Microsoft.Web/sites/host', functionAppName, 'default'), '2023-12-01')

resource apim 'Microsoft.ApiManagement/service@2024-05-01' = {
  name: '${namePrefix}-apim'
  location: location
  sku: {
    name: 'Consumption'
    capacity: 0
  }
  properties: {
    publisherEmail: publisherEmail
    publisherName: publisherName
  }
}

resource functionKeyNamedValue 'Microsoft.ApiManagement/service/namedValues@2024-05-01' = {
  parent: apim
  name: 'function-host-key'
  properties: {
    displayName: 'function-host-key'
    secret: true
    value: functionHostKeys.functionKeys.default
  }
}

resource api 'Microsoft.ApiManagement/service/apis@2024-05-01' = {
  parent: apim
  name: 'lumina-api'
  properties: {
    displayName: 'Lumina API'
    path: ''
    protocols: [
      'https'
    ]
    serviceUrl: 'https://${functionAppName}.azurewebsites.net'
    subscriptionRequired: false
  }
}

